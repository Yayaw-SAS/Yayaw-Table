{
  "name": "yayaw-table-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "A flexible data table component library for React with user-defined configurations",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "build:watch": "next dev",
    "build:lib": "npm run build -w packages/yayaw-table",
    "type-check:lib": "npm run type-check -w packages/yayaw-table",
    "publish:lib": "npm publish --access public -w packages/yayaw-table",
    "dev": "next dev",
    "start": "next start",
    "build:app": "fumadocs-mdx && next build",
    "type-check": "tsc --noEmit",
    "lint": "npx ultracite lint && npx ultracite format",
    "test": "echo 'Add tests here'"
  },
  "keywords": [
    "react",
    "table",
    "datatable",
    "user-defined",
    "flexible",
    "typescript",
    "tailwind"
  ],
  "author": "Yannis",
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "jotai": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "motion/react": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.86.0",
    "@tanstack/react-table": "^8.0.0",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "fumadocs-core": "^15.5.0",
    "fumadocs-mdx": "^11.6.7",
    "fumadocs-typescript": "^4.0.5",
    "fumadocs-ui": "^15.5.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.12.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.542.0",
    "motion": "^12.16.0",
    "next": "^15.3.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "radix-ui": "^1.4.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-inlinesvg": "^4.2.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
