{
  "name": "yayaw-table-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "A flexible data table component library for React with user-defined configurations",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "build:watch": "next dev",
    "build:lib": "cd packages/yayaw-table && bun run build",
    "registry:sync": "node scripts/build-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs && npx shadcn@latest build registry/registry.json --output public/r",
    "type-check:lib": "cd packages/yayaw-table && bun run type-check",
    "publish:lib": "cd packages/yayaw-table && bun publish --access public",
    "dev": "next dev",
    "start": "next start",
    "build:app": "fumadocs-mdx && next build",
    "type-check": "tsc --noEmit",
    "test": "echo 'Add tests here'",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "keywords": [
    "react",
    "table",
    "datatable",
    "user-defined",
    "flexible",
    "typescript",
    "tailwind"
  ],
  "author": "Yannis",
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "jotai": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "motion/react": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.30.0",
    "fumadocs-core": "^16.5.0",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-typescript": "^5.1.1",
    "fumadocs-ui": "^16.5.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.17.0",
    "jotai-family": "^1.0.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "motion": "^12.30.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-inlinesvg": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "7.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/yayaw-table.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/yayaw-table/issues"
  },
  "homepage": "https://github.com/your-username/yayaw-table#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite format"
    ]
  }
}
