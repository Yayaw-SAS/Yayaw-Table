{
  "name": "yayaw-table-workspace",
  "private": true,
  "version": "1.3.0",
  "description": "A flexible, config-driven data table component library for React and Vue 3",
  "scripts": {
    "build": "bun run registry:pages",
    "registry:sync": "node scripts/build-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs && bunx --bun shadcn@latest build registry/registry.json --output public/r && bun run registry:build:vue && bunx ultracite fix registry/registry.json public/r",
    "registry:build:vue": "bun run --cwd packages/yayaw-table-vue registry:build && node scripts/sync-vue-registry.mjs",
    "registry:pages": "bun run registry:build && node scripts/prepare-registry-pages.mjs",
    "registry:snapshot": "node scripts/snapshot-registry-release.mjs",
    "registry:release": "bun run registry:build && bun run registry:snapshot",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-vue-version.mjs && bun run registry:release",
    "release:check": "bun run check && bun run type-check && bun run test && bun run vue:test && bun run vue:build && bun run registry:pages",
    "release:verify": "node scripts/verify-registry-release.mjs",
    "type-check": "tsc --noEmit",
    "test": "bun test src/components/ui/yayaw-table",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "vue:install": "bun install --cwd packages/yayaw-table-vue",
    "vue:dev": "bun run --cwd packages/yayaw-table-vue dev",
    "vue:build": "bun run --cwd packages/yayaw-table-vue build",
    "vue:test": "bun run --cwd packages/yayaw-table-vue test"
  },
  "keywords": [
    "react",
    "vue",
    "vue3",
    "table",
    "datatable",
    "user-defined",
    "flexible",
    "typescript",
    "tailwind"
  ],
  "author": "Yannis",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.7",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.30.0",
    "jotai": "^2.17.0",
    "jotai-family": "^1.0.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.30.0",
    "nuqs": "^2.8.8",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tunnel-rat": "^0.1.2",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/cli": "2.31.0",
    "@types/node": "^22.19.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "lint-staged": "^17.0.4",
    "typescript": "^5.9.3",
    "ultracite": "7.1.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "picomatch": "4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yayaw-SAS/Yayaw-Table.git"
  },
  "bugs": {
    "url": "https://github.com/Yayaw-SAS/Yayaw-Table/issues"
  },
  "homepage": "https://table.yayaw.app",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite format"
    ]
  }
}
