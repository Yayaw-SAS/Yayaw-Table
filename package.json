{
  "name": "yayaw-table-workspace",
  "private": true,
  "version": "0.3.0",
  "description": "A flexible data table component library for React with user-defined configurations",
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "build:watch": "next dev",
    "registry:sync": "node scripts/build-registry.mjs",
    "registry:build": "node scripts/build-registry.mjs && bunx --bun shadcn@latest build registry/registry.json --output public/r",
    "registry:snapshot": "node scripts/snapshot-registry-release.mjs",
    "registry:release": "bun run registry:build && bun run registry:snapshot",
    "changeset": "changeset",
    "version": "changeset version && bun run registry:release",
    "release:check": "bun run check && bun run type-check && bun run test",
    "release:verify": "node scripts/verify-registry-release.mjs",
    "dev": "next dev",
    "start": "next start",
    "build:app": "fumadocs-mdx && next build",
    "type-check": "tsc --noEmit",
    "test": "bun test src/components/ui/yayaw-table",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "keywords": [
    "react",
    "table",
    "datatable",
    "user-defined",
    "flexible",
    "typescript",
    "tailwind"
  ],
  "author": "Yannis",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.7",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@types/mdx": "^2.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.30.0",
    "fumadocs-core": "^16.5.0",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-typescript": "^5.1.1",
    "fumadocs-ui": "^16.5.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.17.0",
    "jotai-family": "^1.0.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "motion": "^12.30.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-inlinesvg": "^4.2.0",
    "react-resizable-panels": "^4.6.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/cli": "2.31.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.8",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.24",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "ultracite": "7.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yayaw-eu/Yayaw-Table.git"
  },
  "bugs": {
    "url": "https://github.com/Yayaw-eu/Yayaw-Table/issues"
  },
  "homepage": "https://table.yayaw.eu",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bunx ultracite format"
    ]
  }
}
