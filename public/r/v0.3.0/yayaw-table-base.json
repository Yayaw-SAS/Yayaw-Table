{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "yayaw-table-base",
  "title": "YaYaw Table Base",
  "description": "Optional Shadcn CLI v4 base that configures a YaYaw-ready design baseline and installs YaYaw Table.",
  "dependencies": [
    "class-variance-authority@^0.7.1",
    "clsx@^2.1.1",
    "lucide-react@^0.563.0",
    "tailwind-merge@^3.4.0",
    "tw-animate-css@^1.4.0"
  ],
  "registryDependencies": ["@yayaw/font-yayaw-sans", "@yayaw/yayaw-table"],
  "cssVars": {
    "theme": {
      "font-sans": "'Plus Jakarta Sans Variable', sans-serif"
    }
  },
  "css": {
    "@import \"tw-animate-css\"": {},
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {}
      }
    }
  },
  "meta": {
    "registryUrl": "https://table.yayaw.eu/r/yayaw-table-base.json",
    "version": "0.3.0",
    "versionedRegistryUrl": "https://table.yayaw.eu/r/v0.3.0/yayaw-table-base.json"
  },
  "docs": "Installs a YaYaw-ready Shadcn base, the optional YaYaw Sans font preset, and YaYaw Table. Existing consumers can keep installing `yayaw-table` directly.",
  "categories": ["base", "theme", "yayaw-table"],
  "type": "registry:base",
  "config": {
    "style": "base-vega",
    "rsc": true,
    "tsx": true,
    "tailwind": {
      "css": "app/global.css",
      "baseColor": "neutral",
      "cssVariables": true,
      "prefix": ""
    },
    "iconLibrary": "lucide",
    "rtl": false,
    "menuColor": "default",
    "menuAccent": "subtle",
    "aliases": {
      "components": "@/components",
      "utils": "@/lib/utils",
      "ui": "@/components/ui",
      "lib": "@/lib",
      "hooks": "@/hooks"
    },
    "registries": {
      "@yayaw": "https://table.yayaw.eu/r/{name}.json"
    }
  }
}
