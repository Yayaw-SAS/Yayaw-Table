{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "yayaw-table-vue-chart",
  "type": "registry:block",
  "title": "YaYaw Table Vue Chart",
  "description": "Optional chart display mode for YaYaw Table Vue (vertical and horizontal bars, line, donut and number), rendered with Unovis as in shadcn-vue charts. Pass `chartRenderer` to `display-mode-renderers` and add \"chart\" to `table.displayModes`.",
  "dependencies": ["@unovis/ts@^1.7.0", "@unovis/vue@^1.7.0"],
  "registryDependencies": ["https://table.yayaw.app/r/yayaw-table-vue.json"],
  "files": [
    {
      "path": "src/chart/ChartCanvas.vue",
      "content": "<script setup lang=\"ts\">\nimport { Donut, GroupedBar, Scatter, StackedBar } from \"@unovis/ts\";\nimport {\n  VisAxis,\n  VisCrosshair,\n  VisDonut,\n  VisGroupedBar,\n  VisLine,\n  VisScatter,\n  VisSingleContainer,\n  VisStackedBar,\n  VisTooltip,\n  VisXYContainer,\n  VisXYLabels,\n} from \"@unovis/vue\";\nimport { computed } from \"vue\";\nimport type {\n  ChartCategory,\n  ChartLabelKey,\n  ChartModel,\n  ChartSeriesItem,\n  ResolvedChartSettings,\n} from \"../chart-model\";\n\nconst props = defineProps<{\n  model: ChartModel;\n  settings: ResolvedChartSettings;\n  clickable: boolean;\n  label: (key: ChartLabelKey, params?: Record<string, number | string>) => string;\n}>();\nconst emit = defineEmits<{\n  group: [category?: ChartCategory, series?: ChartSeriesItem];\n}>();\n\nconst CHART_HEIGHT = 320;\nconst ROW_HEIGHT = 36;\nconst MARGIN = { top: 20, right: 24, bottom: 4, left: 8 };\n\ninterface ChartRow {\n  i: number;\n  id: string;\n  label: string;\n  color: string;\n  values: number[];\n}\n\nconst rows = computed<ChartRow[]>(() =>\n  props.model.categories.map((category, index) => ({\n    i: index,\n    id: category.id,\n    label: category.label,\n    color: category.color,\n    values: props.model.series.map((item) => category.values[item.id] ?? 0),\n  }))\n);\nconst horizontal = computed(() => props.model.type === \"horizontalBar\");\nconst stacked = computed(\n  () => props.model.stacked || props.model.series.length === 1\n);\nconst height = computed(() =>\n  horizontal.value\n    ? Math.max(CHART_HEIGHT, rows.value.length * ROW_HEIGHT)\n    : CHART_HEIGHT\n);\n// Horizontal bars list categories from the top, as in React.\nconst x = (row: ChartRow): number =>\n  horizontal.value ? rows.value.length - 1 - row.i : row.i;\nconst categoryDomain = computed<[number, number]>(() => [\n  -0.5,\n  Math.max(0.5, rows.value.length - 0.5),\n]);\nconst valueDomain = computed<[number, number]>(() => [\n  props.model.valueTicks.at(0) ?? 0,\n  props.model.valueTicks.at(-1) ?? 1,\n]);\nconst ys = computed(() =>\n  props.model.series.map((_, index) => (row: ChartRow) => row.values[index] ?? 0)\n);\nconst seriesColor = (row: ChartRow, index: number): string =>\n  props.model.single ? row.color : (props.model.series[index]?.color ?? row.color);\nconst ticks = computed(() => rows.value.map((row) => x(row)));\nconst tickLabel = (value: number | Date): string =>\n  rows.value.find((row) => x(row) === Number(value))?.label ?? \"\";\nconst valueTick = (value: number | Date): string => props.model.format(Number(value));\nconst cursor = computed(() => (props.clickable ? \"pointer\" : \"default\"));\n\nconst escape = (text: string): string =>\n  text.replace(/[&<>\"']/g, (character) => `&#${character.charCodeAt(0)};`);\nconst tooltipRows = (row: ChartRow, only?: number): string =>\n  props.model.series\n    .map((item, index) => ({ item, index }))\n    .filter(({ index }) => only === undefined || index === only)\n    .map(\n      ({ item, index }) =>\n        `<div class=\"yayaw-chart-tip-row\"><span class=\"yayaw-chart-swatch\" style=\"background:${seriesColor(row, index)}\"></span><span class=\"yayaw-chart-muted\">${escape(props.model.single ? props.model.valueLabel : item.label)}</span><strong>${escape(props.model.format(row.values[index] ?? 0))}</strong></div>`\n    )\n    .join(\"\");\nconst tooltip = (row: ChartRow, only?: number): string =>\n  `<div class=\"yayaw-chart-tip\"><div class=\"yayaw-chart-tip-title\">${escape(row.label)}</div>${tooltipRows(row, only)}</div>`;\n\nconst group = (index: unknown, seriesIndex?: unknown): void => {\n  const category = props.model.categories[Number(index)];\n  const series =\n    seriesIndex === undefined ? undefined : props.model.series[Number(seriesIndex)];\n  emit(\"group\", category, series);\n};\n\nconst stackedEvents = computed(() => ({\n  [StackedBar.selectors.bar]: {\n    click: (datum: { i: number; stackIndex?: number }) =>\n      group(datum.i, datum.stackIndex),\n  },\n}));\nconst groupedEvents = computed(() => ({\n  [GroupedBar.selectors.bar]: {\n    click: (datum: ChartRow, _event: Event, index: number) => group(datum.i, index),\n  },\n}));\nconst pointEvents = computed(() => ({\n  [Scatter.selectors.point]: {\n    click: (datum: ChartRow) => group(datum.i),\n  },\n}));\nconst donutRows = computed(() => rows.value.filter((row) => (row.values[0] ?? 0) > 0));\nconst donutEvents = computed(() => ({\n  [Donut.selectors.segment]: {\n    click: (arc: { data: ChartRow }) => group(arc.data.i),\n  },\n}));\nconst barTriggers = computed(() => ({\n  [StackedBar.selectors.bar]: (datum: ChartRow & { stackIndex?: number }) =>\n    tooltip(datum, props.model.single ? undefined : datum.stackIndex),\n  [GroupedBar.selectors.bar]: (datum: ChartRow) => tooltip(datum),\n  [Donut.selectors.segment]: (arc: { data: ChartRow }) => tooltip(arc.data),\n}));\nconst crosshairTemplate = (row: ChartRow): string => tooltip(row);\n\n// Single bars carry their label just past their end.\nconst labelOffset = computed(\n  () => ((props.model.valueTicks.at(-1) ?? 1) - (props.model.valueTicks.at(0) ?? 0)) * (horizontal.value ? 0.08 : 0.04)\n);\n/** Data labels: at the top of single bars, in the middle of stacked segments. */\nconst labelSets = computed(() => {\n  if (!props.settings.showDataLabels) return [];\n  const multiple = props.model.series.length > 1;\n  if (multiple && !props.model.stacked) return [];\n  return props.model.series.map((_, index) => ({\n    index,\n    y: (row: ChartRow) => {\n      const value = row.values[index] ?? 0;\n      if (!multiple) return value + labelOffset.value;\n      const below = row.values.slice(0, index).reduce((sum, item) => sum + item, 0);\n      return below + value / 2;\n    },\n    label: (row: ChartRow) => {\n      const value = row.values[index] ?? 0;\n      return value ? props.model.format(value) : \"\";\n    },\n  }));\n});\n</script>\n\n<template>\n  <div class=\"yayaw-chart-canvas\" :data-chart-clickable=\"props.clickable ? 'true' : undefined\">\n    <VisSingleContainer v-if=\"props.model.type === 'donut'\" :data=\"donutRows\" :height=\"CHART_HEIGHT\">\n      <VisDonut\n        :value=\"(row: ChartRow) => row.values[0] ?? 0\"\n        :color=\"(row: ChartRow) => row.color\"\n        :arc-width=\"56\"\n        :pad-angle=\"0.01\"\n        :central-label=\"props.model.format(props.model.total)\"\n        :central-sub-label=\"props.label('total')\"\n        :events=\"donutEvents\"\n      />\n      <VisTooltip :triggers=\"barTriggers\" />\n    </VisSingleContainer>\n    <VisXYContainer\n      v-else-if=\"props.model.type === 'line'\"\n      :data=\"rows\"\n      :height=\"CHART_HEIGHT\"\n      :margin=\"MARGIN\"\n      :x-domain=\"categoryDomain\"\n      :y-domain=\"valueDomain\"\n    >\n      <VisLine :x=\"x\" :y=\"ys\" :color=\"(_rows: ChartRow[], index: number) => props.model.series[index]?.color\" :line-width=\"2\" curve-type=\"monotoneX\" />\n      <VisScatter\n        v-for=\"(item, index) in props.model.series\"\n        :key=\"item.id\"\n        :x=\"x\"\n        :y=\"ys[index]\"\n        :color=\"item.color\"\n        :size=\"8\"\n        :cursor=\"cursor\"\n        :label=\"props.settings.showDataLabels ? (row: ChartRow) => props.model.format(row.values[index] ?? 0) : undefined\"\n        label-position=\"top\"\n        :events=\"pointEvents\"\n      />\n      <VisAxis type=\"x\" :tick-values=\"ticks\" :tick-format=\"tickLabel\" :grid-line=\"false\" :tick-line=\"false\" :domain-line=\"false\" />\n      <VisAxis type=\"y\" :tick-values=\"props.model.valueTicks\" :tick-format=\"valueTick\" :tick-line=\"false\" :domain-line=\"false\" />\n      <VisCrosshair :template=\"crosshairTemplate\" :color=\"(_row: ChartRow, index: number) => props.model.series[index]?.color\" />\n      <VisTooltip />\n    </VisXYContainer>\n    <VisXYContainer\n      v-else\n      :data=\"rows\"\n      :height=\"height\"\n      :margin=\"MARGIN\"\n      :x-domain=\"horizontal ? valueDomain : categoryDomain\"\n      :y-domain=\"horizontal ? categoryDomain : valueDomain\"\n    >\n      <VisStackedBar\n        v-if=\"stacked\"\n        :x=\"x\"\n        :y=\"ys\"\n        :color=\"seriesColor\"\n        :orientation=\"horizontal ? 'horizontal' : 'vertical'\"\n        :rounded-corners=\"props.model.series.length > 1 ? 0 : 4\"\n        :bar-padding=\"0.2\"\n        :bar-max-width=\"64\"\n        :cursor=\"cursor\"\n        :events=\"stackedEvents\"\n      />\n      <VisGroupedBar\n        v-else\n        :x=\"x\"\n        :y=\"ys\"\n        :color=\"seriesColor\"\n        :orientation=\"horizontal ? 'horizontal' : 'vertical'\"\n        :rounded-corners=\"4\"\n        :group-padding=\"0.2\"\n        :bar-max-width=\"64\"\n        :cursor=\"cursor\"\n        :events=\"groupedEvents\"\n      />\n      <template v-if=\"labelSets.length\">\n        <VisXYLabels\n          v-for=\"set in labelSets\"\n          :key=\"set.index\"\n          :x=\"horizontal ? set.y : x\"\n          :y=\"horizontal ? x : set.y\"\n          :label=\"set.label\"\n          background-color=\"transparent\"\n          color=\"var(--yayaw-foreground)\"\n          :label-font-size=\"11\"\n        />\n      </template>\n      <VisAxis\n        :type=\"horizontal ? 'y' : 'x'\"\n        :tick-values=\"ticks\"\n        :tick-format=\"tickLabel\"\n        :grid-line=\"false\"\n        :tick-line=\"false\"\n        :domain-line=\"false\"\n      />\n      <VisAxis :type=\"horizontal ? 'x' : 'y'\" :tick-values=\"props.model.valueTicks\" :tick-format=\"valueTick\" :tick-line=\"false\" :domain-line=\"false\" />\n      <VisTooltip :triggers=\"barTriggers\" />\n    </VisXYContainer>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/ui/yayaw-table-vue/chart/ChartCanvas.vue"
    },
    {
      "path": "src/chart/ChartSettings.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nimport { chartSettingFields, type ChartViewSettings } from \"../chart-model\";\nimport ViewSettingsPanel from \"../components/controls/ViewSettingsPanel.vue\";\nimport type { DisplayModeSettingsContext } from \"../display-mode-renderer\";\n\nconst props = defineProps<{ context: DisplayModeSettingsContext }>();\nconst view = computed(() => props.context.settings as ChartViewSettings);\nconst fields = computed(() =>\n  chartSettingFields({\n    columns: props.context.columns,\n    defaults: props.context.defaults as ChartViewSettings,\n    view: view.value,\n    locale: props.context.locale,\n    translate: (key, fallback) => props.context.translate(`chart.${key}`, fallback),\n    update: (next) => props.context.updateSettings(next),\n  })\n);\n</script>\n\n<template>\n  <ViewSettingsPanel :fields=\"fields\">\n    <button\n      type=\"button\"\n      class=\"yayaw-button yayaw-button-outline\"\n      :disabled=\"Object.keys(view).length === 0\"\n      @click=\"props.context.updateSettings(undefined)\"\n    >\n      {{ props.context.translate(\"reset\", \"Reset\") }}\n    </button>\n  </ViewSettingsPanel>\n</template>\n",
      "type": "registry:component",
      "target": "components/ui/yayaw-table-vue/chart/ChartSettings.vue"
    },
    {
      "path": "src/chart/ChartTable.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ChartCategory, ChartLabelKey, ChartModel } from \"../chart-model\";\n\nconst props = defineProps<{\n  model: ChartModel;\n  clickable: boolean;\n  label: (key: ChartLabelKey, params?: Record<string, number | string>) => string;\n}>();\nconst emit = defineEmits<{ group: [category: ChartCategory] }>();\n</script>\n\n<template>\n  <div class=\"yayaw-chart-table-wrap\">\n    <table class=\"yayaw-chart-table\" data-chart-table>\n      <caption class=\"yayaw-sr-only\">{{ props.model.title }}</caption>\n      <thead>\n        <tr>\n          <th scope=\"col\">{{ props.model.xLabel || props.label(\"group\") }}</th>\n          <th v-for=\"item in props.model.series\" :key=\"item.id\" scope=\"col\" class=\"yayaw-chart-number\">\n            {{ props.model.single ? props.model.valueLabel : item.label }}\n          </th>\n          <th v-if=\"!props.model.single\" scope=\"col\" class=\"yayaw-chart-number\">{{ props.label(\"total\") }}</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"category in props.model.categories\" :key=\"category.id\">\n          <th scope=\"row\">\n            <button\n              v-if=\"props.clickable && !category.other\"\n              type=\"button\"\n              class=\"yayaw-chart-link\"\n              :aria-label=\"props.label('showRecords', { group: category.label })\"\n              @click=\"emit('group', category)\"\n            >\n              {{ category.label }}\n            </button>\n            <template v-else>{{ category.label }}</template>\n          </th>\n          <td v-for=\"item in props.model.series\" :key=\"item.id\" class=\"yayaw-chart-number\">\n            {{ props.model.format(category.values[item.id] ?? 0) }}\n          </td>\n          <td v-if=\"!props.model.single\" class=\"yayaw-chart-number yayaw-chart-strong\">\n            {{ props.model.format(category.total) }}\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</template>\n",
      "type": "registry:component",
      "target": "components/ui/yayaw-table-vue/chart/ChartTable.vue"
    },
    {
      "path": "src/chart/ChartView.vue",
      "content": "<script setup lang=\"ts\">\nimport { Table2 } from \"lucide-vue-next\";\nimport { computed, ref, shallowRef, watch } from \"vue\";\nimport {\n  buildChartModel,\n  type ChartCategory,\n  type ChartDataResult,\n  type ChartLabelKey,\n  type ChartSeriesItem,\n  type ChartViewSettings,\n  canAddChartFilters,\n  chartAggregateRequest,\n  chartGroupFilters,\n  chartLabel,\n  loadChartData,\n  resolveChartSettings,\n} from \"../chart-model\";\nimport type { DisplayModeRenderContext } from \"../display-mode-renderer\";\nimport ChartCanvas from \"./ChartCanvas.vue\";\nimport ChartTable from \"./ChartTable.vue\";\nimport \"./chart.css\";\n\nconst props = defineProps<{ context: DisplayModeRenderContext }>();\n\n/** The host's shadcn chart tokens (with YaYaw fallbacks), light and dark. */\nconst PALETTE = [\n  \"var(--yayaw-chart-1)\",\n  \"var(--yayaw-chart-2)\",\n  \"var(--yayaw-chart-3)\",\n  \"var(--yayaw-chart-4)\",\n  \"var(--yayaw-chart-5)\",\n];\nconst OTHER_COLOR = \"var(--yayaw-muted-foreground)\";\n\nconst translate = (key: string, fallback: string): string =>\n  props.context.translate(`chart.${key}`, fallback);\nconst label = (\n  key: ChartLabelKey,\n  params?: Record<string, number | string>\n): string => chartLabel(key, props.context.locale, translate, params);\n\nconst settings = computed(() =>\n  resolveChartSettings(\n    props.context.columns,\n    props.context.defaults as ChartViewSettings,\n    props.context.settings as ChartViewSettings\n  )\n);\nconst request = computed(() =>\n  chartAggregateRequest(settings.value, props.context.columns)\n);\nconst result = shallowRef<ChartDataResult>();\nconst error = ref<string>();\nconst loading = ref(true);\nconst asTable = ref(false);\nconst notice = ref<string>();\n\nlet pending: AbortController | undefined;\n// Groups from `actions.aggregate`, or computed over the rows matching the query.\nwatch(\n  () => [\n    JSON.stringify(request.value ?? null),\n    props.context.aggregate,\n    props.context.list,\n    props.context.listParams,\n    props.context.list ? undefined : props.context.rows,\n    props.context.revision,\n    props.context.locale,\n  ],\n  async () => {\n    pending?.abort();\n    const current = request.value;\n    if (!current) {\n      loading.value = false;\n      return;\n    }\n    const controller = new AbortController();\n    pending = controller;\n    loading.value = true;\n    try {\n      result.value = await loadChartData({\n        aggregate: props.context.aggregate,\n        list: props.context.list,\n        rows: props.context.list ? undefined : props.context.rows,\n        params: props.context.listParams,\n        request: current,\n        locale: props.context.locale,\n        signal: controller.signal,\n      });\n      error.value = undefined;\n      loading.value = false;\n    } catch (cause) {\n      if (!controller.signal.aborted) {\n        error.value = cause instanceof Error ? cause.message : String(cause);\n        loading.value = false;\n      }\n    }\n  },\n  { immediate: true }\n);\n\nconst model = computed(() =>\n  result.value\n    ? buildChartModel({\n        result: result.value,\n        settings: settings.value,\n        columns: props.context.columns,\n        locale: props.context.locale,\n        translate,\n        palette: PALETTE,\n        otherColor: OTHER_COLOR,\n        coloredTags: props.context.coloredTags,\n      })\n    : undefined\n);\nconst clickable = computed(\n  () =>\n    settings.value.type !== \"number\" &&\n    canAddChartFilters(props.context.advancedFilters)\n);\nconst hasTable = computed(() => Boolean(model.value) && model.value?.type !== \"number\");\nconst visible = computed(\n  () => model.value && !(model.value.empty && model.value.type !== \"number\")\n);\nconst legendItems = computed(() => {\n  const current = model.value;\n  if (!(current && settings.value.showLegend)) return [];\n  if (current.type === \"donut\") {\n    return current.categories\n      .filter((category) => category.total > 0)\n      .map((category) => ({\n        id: category.id,\n        label: category.label,\n        color: category.color,\n        value: category.total as number | undefined,\n      }));\n  }\n  if (current.single || current.type === \"number\") return [];\n  return current.series.map((item) => ({\n    id: item.id,\n    label: item.label,\n    color: item.color,\n    value: undefined as number | undefined,\n  }));\n});\n\nconst onGroup = (category?: ChartCategory, series?: ChartSeriesItem): void => {\n  const rules = chartGroupFilters(settings.value, props.context.columns, {\n    category,\n    series,\n  });\n  if (!rules) return;\n  if (!props.context.showRecords(rules as unknown as Record<string, unknown>[])) {\n    notice.value = label(\"filterUnavailable\");\n  }\n};\n</script>\n\n<template>\n  <output v-if=\"!(settings.xColumn || settings.type === 'number')\" class=\"yayaw-chart-message\">\n    {{ label(\"noColumn\") }}\n  </output>\n  <section\n    v-else\n    class=\"yayaw-chart-view\"\n    :aria-busy=\"loading\"\n    :aria-label=\"model?.title\"\n    :data-chart-type=\"settings.type\"\n  >\n    <div class=\"yayaw-chart-header\">\n      <h3 class=\"yayaw-chart-title\" data-chart-title>{{ model?.title }}</h3>\n      <button\n        v-if=\"hasTable\"\n        type=\"button\"\n        class=\"yayaw-button yayaw-button-outline\"\n        :aria-pressed=\"asTable\"\n        @click=\"asTable = !asTable\"\n      >\n        <Table2 :size=\"16\" aria-hidden=\"true\" />\n        {{ label(asTable ? \"showChart\" : \"showTable\") }}\n      </button>\n    </div>\n    <div v-if=\"error\" class=\"yayaw-chart-message yayaw-chart-error\" role=\"alert\">{{ error }}</div>\n    <div v-if=\"notice\" class=\"yayaw-chart-message yayaw-chart-error\" role=\"alert\">{{ notice }}</div>\n    <output v-if=\"result?.truncated\" class=\"yayaw-chart-message\">{{ label(\"truncated\") }}</output>\n    <output v-if=\"!model && loading\" class=\"yayaw-chart-message\">{{ label(\"loading\") }}</output>\n    <output v-if=\"model?.empty && model.type !== 'number'\" class=\"yayaw-chart-message\">{{ label(\"empty\") }}</output>\n    <div v-if=\"model && visible\" class=\"yayaw-chart-body\" :class=\"{ 'yayaw-chart-loading': loading }\">\n      <ChartTable\n        v-if=\"asTable && hasTable\"\n        :model=\"model\"\n        :clickable=\"clickable\"\n        :label=\"label\"\n        @group=\"onGroup\"\n      />\n      <ChartCanvas\n        v-else\n        :model=\"model\"\n        :settings=\"settings\"\n        :clickable=\"clickable\"\n        :label=\"label\"\n        @group=\"onGroup\"\n      />\n      <ul v-if=\"legendItems.length && !asTable\" class=\"yayaw-chart-legend\" data-chart-legend>\n        <li v-for=\"item in legendItems\" :key=\"item.id\">\n          <span class=\"yayaw-chart-swatch\" :style=\"{ background: item.color }\" aria-hidden=\"true\" />\n          <span>{{ item.label }}</span>\n          <span v-if=\"settings.showDataLabels && item.value !== undefined\" class=\"yayaw-chart-muted\">{{ model.format(item.value) }}</span>\n        </li>\n      </ul>\n      <p v-if=\"hasTable && !asTable\" class=\"yayaw-chart-hint\" data-chart-hint>\n        {{ label(clickable ? \"filterHint\" : \"filterUnavailable\") }}\n      </p>\n    </div>\n  </section>\n</template>\n",
      "type": "registry:component",
      "target": "components/ui/yayaw-table-vue/chart/ChartView.vue"
    },
    {
      "path": "src/chart/chart-renderer.ts",
      "content": "import { defineAsyncComponent } from \"vue\";\nimport type { DisplayModeRenderer } from \"../display-mode-renderer\";\nimport ChartSettings from \"./ChartSettings.vue\";\n\n/**\n * Pass to `<YayawDataTable :display-mode-renderers=\"{ chart: chartRenderer }\" />`\n * and list `\"chart\"` in `table.displayModes`. Unovis loads with the first\n * chart shown, not with the table.\n */\nexport const chartRenderer: DisplayModeRenderer = {\n  view: defineAsyncComponent(() => import(\"./ChartView.vue\")),\n  settings: ChartSettings,\n};\n",
      "type": "registry:component",
      "target": "components/ui/yayaw-table-vue/chart/chart-renderer.ts"
    },
    {
      "path": "src/chart/chart.css",
      "content": "/* Unovis follows the host's shadcn tokens, light and dark, as the React chart does. */\n:root {\n  /* The host's shadcn chart palette wins; fallbacks are shadcn's neutral theme. */\n  --yayaw-chart-1: var(--chart-1, oklch(0.646 0.222 41.116));\n  --yayaw-chart-2: var(--chart-2, oklch(0.6 0.118 184.704));\n  --yayaw-chart-3: var(--chart-3, oklch(0.398 0.07 227.392));\n  --yayaw-chart-4: var(--chart-4, oklch(0.828 0.189 84.429));\n  --yayaw-chart-5: var(--chart-5, oklch(0.769 0.188 70.08));\n}\n.dark {\n  --yayaw-chart-1: var(--chart-1, oklch(0.488 0.243 264.376));\n  --yayaw-chart-2: var(--chart-2, oklch(0.696 0.17 162.48));\n  --yayaw-chart-3: var(--chart-3, oklch(0.769 0.188 70.08));\n  --yayaw-chart-4: var(--chart-4, oklch(0.627 0.265 303.9));\n  --yayaw-chart-5: var(--chart-5, oklch(0.645 0.246 16.439));\n}\n.yayaw-chart-view {\n  display: grid;\n  gap: 0.75rem;\n  color: var(--yayaw-foreground);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n.yayaw-chart-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n}\n.yayaw-chart-header .yayaw-button {\n  height: 2rem;\n  gap: 0.375rem;\n  font-size: 0.75rem;\n  font-weight: 400;\n}\n.yayaw-chart-title {\n  margin: 0;\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n.yayaw-chart-message {\n  display: block;\n  color: var(--yayaw-muted-foreground);\n  font-size: 0.875rem;\n}\n.yayaw-chart-error {\n  color: var(--yayaw-danger);\n}\n.yayaw-chart-body {\n  display: grid;\n  gap: 0.75rem;\n}\n.yayaw-chart-loading {\n  opacity: 0.6;\n}\n.yayaw-chart-canvas {\n  --vis-font-family: inherit;\n  --vis-axis-tick-label-color: var(--yayaw-muted-foreground);\n  --vis-axis-tick-label-font-size: 12px;\n  --vis-axis-grid-color: color-mix(\n    in oklab,\n    var(--yayaw-border) 60%,\n    transparent\n  );\n  --vis-axis-domain-color: transparent;\n  --vis-axis-tick-color: transparent;\n  --vis-tooltip-background-color: var(--yayaw-background);\n  --vis-tooltip-border-color: var(--yayaw-border);\n  --vis-tooltip-text-color: var(--yayaw-foreground);\n  --vis-tooltip-padding: 6px 10px;\n  --vis-tooltip-border-radius: calc(var(--yayaw-radius) + 2px);\n  --vis-crosshair-line-stroke-color: var(--yayaw-border);\n  --vis-crosshair-circle-stroke-color: var(--yayaw-background);\n  --vis-donut-central-label-text-color: var(--yayaw-foreground);\n  --vis-donut-central-label-font-size: 24px;\n  --vis-donut-central-label-font-weight: 600;\n  --vis-donut-central-sub-label-text-color: var(--yayaw-muted-foreground);\n  --vis-donut-central-sub-label-font-size: 12px;\n  --vis-donut-background-color: var(--yayaw-muted);\n  --vis-scatter-point-label-text-color-dark: var(--yayaw-foreground);\n  --vis-scatter-point-label-text-color-light: var(--yayaw-foreground);\n  --vis-scatter-point-label-text-font-size: 11px;\n  --vis-xy-label-text-color-dark: var(--yayaw-foreground);\n  --vis-xy-label-text-color-light: var(--yayaw-foreground);\n  width: 100%;\n}\n.yayaw-chart-canvas[data-chart-clickable] :is(path, circle) {\n  outline: none;\n}\n.yayaw-chart-tip {\n  display: grid;\n  min-width: 8rem;\n  gap: 0.375rem;\n  font-size: 0.75rem;\n}\n.yayaw-chart-tip-title {\n  font-weight: 500;\n}\n.yayaw-chart-tip-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n.yayaw-chart-tip-row strong {\n  margin-left: auto;\n  font-family: ui-monospace, monospace;\n  font-weight: 500;\n  font-variant-numeric: tabular-nums;\n}\n.yayaw-chart-swatch {\n  display: inline-block;\n  width: 0.625rem;\n  height: 0.625rem;\n  flex-shrink: 0;\n  border-radius: 2px;\n}\n.yayaw-chart-muted {\n  color: var(--yayaw-muted-foreground);\n  font-variant-numeric: tabular-nums;\n}\n.yayaw-chart-legend {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.25rem 1rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  font-size: 0.75rem;\n}\n.yayaw-chart-legend li {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n}\n.yayaw-chart-hint {\n  margin: 0;\n  color: var(--yayaw-muted-foreground);\n  font-size: 0.75rem;\n}\n.yayaw-chart-table-wrap {\n  overflow-x: auto;\n  border: 1px solid var(--yayaw-border);\n  border-radius: var(--yayaw-radius);\n}\n.yayaw-chart-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.875rem;\n}\n.yayaw-chart-table thead {\n  background: color-mix(in oklab, var(--yayaw-muted) 50%, transparent);\n  color: var(--yayaw-muted-foreground);\n  text-align: left;\n}\n.yayaw-chart-table th,\n.yayaw-chart-table td {\n  padding: 0.375rem 0.75rem;\n}\n.yayaw-chart-table thead th {\n  padding-block: 0.5rem;\n  font-weight: 500;\n}\n.yayaw-chart-table tbody tr {\n  border-top: 1px solid var(--yayaw-border);\n}\n.yayaw-chart-table tbody th {\n  font-weight: 400;\n  text-align: left;\n}\n.yayaw-chart-number {\n  text-align: right !important;\n  font-variant-numeric: tabular-nums;\n}\n.yayaw-chart-strong {\n  font-weight: 500;\n}\n.yayaw-chart-link {\n  padding: 0;\n  border: 0;\n  background: none;\n  color: var(--yayaw-foreground);\n  font: inherit;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n  cursor: pointer;\n}\n.yayaw-chart-link:focus-visible {\n  outline: 2px solid var(--yayaw-ring);\n  outline-offset: 2px;\n  border-radius: 2px;\n}\n",
      "type": "registry:style",
      "target": "components/ui/yayaw-table-vue/chart/chart.css"
    }
  ]
}
