{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/next",
    "ultracite/core",
    "ultracite/biome/core",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": ["!src/ui/shadcn"]
  },
  "overrides": [
    {
      "includes": ["index.ts", "**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [".source/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noVar": "off"
          }
        }
      }
    }
  ]
}
