{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/biome/core"],
  "files": {
    "includes": [
      "!src/ui/shadcn",
      "!src/components/ui",
      "!packages/yayaw-table-vue/**/*.vue",
      "!packages/yayaw-table-vue/src/components/questionnaire",
      "!public/r/yayaw-table.json",
      "!public/r/v*"
    ]
  },
  "overrides": [
    {
      "includes": ["index.ts", "**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/yayaw-table-vue/src/public-types.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
