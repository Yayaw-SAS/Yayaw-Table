{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": [
      "**",
      "!src/components/ui/**",
      "!**/*.css",
      "!src/app/globals.css",
      "!.source/**",
      "!content/**"
    ]
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui-custom/icon.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
