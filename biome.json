{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/next",
    "ultracite/core",
    "ultracite/biome/core",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!.source",
      "!src/ui/shadcn",
      "!src/components/ui",
      "!packages/yayaw-table-vue/**/*.vue",
      "!public/r/yayaw-table.json",
      "!public/r/v*/yayaw-table.json",
      "!public/r/v*/registry.json"
    ]
  },
  "overrides": [
    {
      "includes": ["index.ts", "**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/yayaw-table-vue/src/public-types.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
