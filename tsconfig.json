{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/src/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "incremental": true
  },
  "include": [
    "index.ts",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.tsx",
    "examples/record-presentation-react.tsx",
    "examples/record-presentation-preview/main.tsx",
    "examples/gantt-react.tsx",
    "examples/gantt-data.ts",
    "examples/gantt-preview/main.tsx",
    "examples/views.ts",
    "examples/views-spreadsheet.ts",
    "examples/views-react.tsx",
    "examples/value-formats.ts",
    "examples/value-formats-react.tsx",
    "examples/dashboard.ts",
    "examples/dashboard-react.tsx",
    "examples/screen.ts",
    "examples/screen-react.tsx",
    "examples/assets.ts",
    "examples/assets-react.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "registry", "packages/yayaw-table-vue"]
}
