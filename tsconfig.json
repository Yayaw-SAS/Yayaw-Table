{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/src/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "incremental": true
  },
  "include": [
    "index.ts",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "registry", "packages/yayaw-table-vue"]
}
